cabal-version:      3.0
name:               conso-site-db
version:            0.1.0.0
license:            LGPL-3.0-or-later
license-file:       LICENSE
author:             mlier
maintainer:         mlier@free.fr
category:           database
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        -- Registre central (UUID ↔ PRM ↔ PCE)
        Conso.Fr.SiteDB.Types
        Conso.Fr.SiteDB.Registry
        Conso.Fr.SiteDB.Registry.Schema
        Conso.Fr.SiteDB.Registry.Operations
        -- Connexion SQLite core (sans migrations)
        Conso.Fr.SiteDB.Storage.Connection
        -- Orchestration (logique métier partagée)
        Conso.Fr.SiteDB.Orchestration.Types
        Conso.Fr.SiteDB.Orchestration.Adresses
        Conso.Fr.SiteDB.Orchestration.Prm
        Conso.Fr.SiteDB.Orchestration.Pce
        Conso.Fr.SiteDB.Orchestration.Desinscription

    build-depends:
          base >=4.17 && <5
        , uuid >= 1.3
        , text
        , time
        , sqlite-simple
        , directory
        , filepath
        , conso-elec-sge
        , conso-gaz-adict
        , HaXml
        , containers

    hs-source-dirs:   src
    default-language: Haskell2010

executable conso-registre
    import:           warnings
    main-is:          Main.hs
    other-modules:    Display
    hs-source-dirs:   app
    build-depends:
          base              >= 4.17 && < 5
        , conso-site-db
        , conso-gaz-adict
        , sqlite-simple
        , text
        , uuid
        , optparse-applicative
        , directory
        , filepath
    default-language: Haskell2010
    ghc-options:      -threaded
