cabal-version:      3.0
name:               conso-site-db
version:            0.1.0.0
license:            LGPL-3.0-or-later
license-file:       LICENSE
author:             mlier
maintainer:         mlier@free.fr
category:           database
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        -- Registre central (UUID ↔ PRM ↔ PCE)
        Conso.Fr.Site.Types
        Conso.Fr.Site.Registry
        Conso.Fr.Site.Registry.Schema
        Conso.Fr.Site.Registry.Operations

        -- SgeDB : stockage électricité (façade)
        Conso.Fr.Site.SiteDB.Elec

        -- SgeDB : types
        Conso.Fr.Site.SiteDB.Elec.Types.Common
        Conso.Fr.Site.SiteDB.Elec.Types.Header
        Conso.Fr.Site.SiteDB.Elec.Types.R63
        Conso.Fr.Site.SiteDB.Elec.Types.R64
        Conso.Fr.Site.SiteDB.Elec.Types.R65
        Conso.Fr.Site.SiteDB.Elec.Types.R66
        Conso.Fr.Site.SiteDB.Elec.Types.R67
        Conso.Fr.Site.SiteDB.Elec.Types.C68

        -- SgeDB : stockage SQLite
        Conso.Fr.Site.SiteDB.Elec.Storage.Connection
        Conso.Fr.Site.SiteDB.Elec.Storage.Migration
        Conso.Fr.Site.SiteDB.Elec.Storage.Schema
        Conso.Fr.Site.SiteDB.Elec.Storage.Insert
        Conso.Fr.Site.SiteDB.Elec.Storage.Query
        Conso.Fr.Site.SiteDB.Elec.Storage.Gaps

        -- SgeDB : ingestion JSON
        Conso.Fr.Site.SiteDB.Elec.Ingestion.Parser
        Conso.Fr.Site.SiteDB.Elec.Ingestion.Versioning
        Conso.Fr.Site.SiteDB.Elec.Ingestion.Batch
        Conso.Fr.Site.SiteDB.Elec.Ingestion.FromRfiles
        Conso.Fr.Site.SiteDB.Elec.Ingestion.GapFill

        -- AdictDB : stockage gaz
        Conso.Fr.Site.SiteDB.Gaz.Types
        Conso.Fr.Site.SiteDB.Gaz.Storage.Migration
        Conso.Fr.Site.SiteDB.Gaz.Storage.Insert
        Conso.Fr.Site.SiteDB.Gaz.Ingestion.FromApi

        -- SgeDB : analyse
        Conso.Fr.Site.SiteDB.Elec.Analysis.Aggregate
        Conso.Fr.Site.SiteDB.Elec.Analysis.Compare
        Conso.Fr.Site.SiteDB.Elec.Analysis.Anomaly

        -- SgeDB : export
        Conso.Fr.Site.SiteDB.Elec.Export.CSV
        Conso.Fr.Site.SiteDB.Elec.Export.JSON
        Conso.Fr.Site.SiteDB.Elec.Export.Consolidate

    build-depends:
          base >=4.17 && <5
        , uuid >= 1.3
        , text
        , time
        , sqlite-simple
        , directory
        , filepath
        , aeson
        , bytestring
        , containers
        , pretty-simple
        , pretty
    hs-source-dirs:   src
    default-language: Haskell2010
