cabal-version:      3.0
name:               conso-registre
version:            0.1.0.0
license:            LGPL-3.0-or-later
license-file:       LICENSE
author:             mlier
maintainer:         mlier@free.fr
category:           database
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

executable conso-registre
    import:           warnings
    main-is:          Main.hs
    other-modules:    Display
    hs-source-dirs:   app
    build-depends:
          base              >= 4.17 && < 5
        , conso-site-db
        , conso-site-db-elec
        , conso-site-db-gaz
        , sqlite-simple
        , text
        , uuid
        , optparse-applicative
        , directory
        , filepath
    default-language: Haskell2010
    ghc-options:      -threaded
