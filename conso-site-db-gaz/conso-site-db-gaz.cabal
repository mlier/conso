cabal-version:      3.0
name:               conso-site-db-gaz
version:            0.1.0.0
license:            LGPL-3.0-or-later
license-file:       LICENSE
author:             mlier
maintainer:         mlier@free.fr
category:           database
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        Conso.Fr.Gaz.SiteDB.Types
        Conso.Fr.Gaz.SiteDB.Storage.Connection
        Conso.Fr.Gaz.SiteDB.Storage.Migration
        Conso.Fr.Gaz.SiteDB.Storage.Insert
        Conso.Fr.Gaz.SiteDB.Ingestion.FromApi
        Conso.Fr.Gaz.SiteDB.Storage.Delete
    build-depends:
          base >=4.17 && <5
        , conso-site-db
        , conso-gaz-adict
        , sqlite-simple
        , text
        , time
        , aeson
        , bytestring
    hs-source-dirs:   src
    default-language: Haskell2010
